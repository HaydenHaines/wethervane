+def overlapping_outputs(outputs):
+    """Lexical Path-component equivalent of pairwise overlap, without filesystem IO.
+
+    Callers retain canonical-path validation. Separate descendant-prefix membership
+    makes detection independent of insertion order, including root and duplicates.
+    """
+    seen = set()
+    ancestors = set()
+    for output in outputs:
+        path = Path(output)
+        if path in seen or path in ancestors or any(parent in seen for parent in path.parents):
+            return True
+        seen.add(path)
+        ancestors.update(path.parents)
+    return False
+
