{
  "name": "ballotmancy-site",
  "version": "0.1.0",
  "private": true,
  "description": "Ballotmancy congressional forecast visualization",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config=playwright.site.config.ts",
    "test:snapshot": "python3 -m unittest discover -s tests -p site_snapshot_test.py",
    "test:tipping": "python3 -m unittest discover -s tests -p site_tipping_test.py",
    "test:explorer-data": "python3 -m unittest discover -s tests -p 'site_*explorer_test.py' && python3 -m unittest discover -s tests -p site_history_test.py",
    "test:explorer-state": "node --experimental-strip-types --test tests/explorer-state.test.mjs",
    "test:ribbon-layout": "node --experimental-strip-types --test tests/ribbon-layout.test.mjs",
    "test:explorer-artifacts": "node --experimental-strip-types --test tests/explorer-artifacts.test.mjs",
    "catalog:build": "python3 scripts/build_explorer_catalog.py",
    "test:composition": "python3 -m unittest discover -s tests -p site_composition_test.py && node --experimental-strip-types --test tests/composition-resolver.test.mjs tests/saved-views.test.mjs",
    "test:poll-selection": "node --test tests/poll-selection.test.mjs",
    "test:scoreboard": "node --experimental-strip-types --test tests/scoreboard.test.mjs tests/presentation.test.mjs",
    "test:house": "node --experimental-strip-types --test tests/chamber.test.mjs tests/district-geography.test.mjs tests/house-ribbon.test.mjs tests/house-publication.test.mjs"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
